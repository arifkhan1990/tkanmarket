# ============================================================
# TkanMarket – Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to git
# ============================================================

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/tkanmarket"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/tkanmarket"

# ------------------------------------------------------------
# REDIS (BullMQ + Rate limiting + Session cache)
# ------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------
# NEXTAUTH
# ------------------------------------------------------------
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------
# OPENAI
# ------------------------------------------------------------
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
OPENAI_MAX_TOKENS="2000"

# ------------------------------------------------------------
# CLOUDFLARE R2 (Image CDN)
# ------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="tkanmarket-images"
CLOUDFLARE_R2_PUBLIC_URL="https://images.tkanmarket.com"

# ------------------------------------------------------------
# SOCIAL MEDIA APIs (Phase 5 – leave empty for Phase 1-4)
# ------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ID=""
TIKTOK_ACCESS_TOKEN=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_ACCESS_TOKEN=""
PINTEREST_BOARD_ID=""
FACEBOOK_ACCESS_TOKEN=""
FACEBOOK_PAGE_ID=""

# ------------------------------------------------------------
# APP CONFIG
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TkanMarket"
NODE_ENV="development"

# Admin first user (for seeding)
SEED_ADMIN_EMAIL="admin@tkanmarket.com"
SEED_ADMIN_PASSWORD="change-this-in-production"

# ------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------
RATE_LIMIT_LEAD_FORM="5"         # requests per hour per IP
RATE_LIMIT_PUBLIC_API="100"      # requests per minute per IP

# ------------------------------------------------------------
# CRAWLER CONFIG
# ------------------------------------------------------------
CRAWLER_MAX_PRODUCTS_PER_RUN="200"
CRAWLER_CONCURRENCY="3"
PLAYWRIGHT_HEADLESS="true"

# Proxy (optional) — see repo root .env.example for CRAWLER_PROXY_HOSTPORT, CRAWLER_PROXY_USERNAME_SUFFIX
CRAWLER_PROXY_URL=""
CRAWLER_PROXY_URLS=""
CRAWLER_PROXY_HOSTPORT=""
CRAWLER_PROXY_PROTOCOL="http"
CRAWLER_PROXY_USERNAME_SUFFIX=""

# Cookies (recommended for 1688/Alibaba)
CRAWLER_SITE_COOKIES=""

# Bandwidth saver (recommended)
CRAWLER_REQUEST_BLOCKING_ENABLED="true"
CRAWLER_BLOCK_IMAGES="true"
CRAWLER_BLOCK_FONTS="true"
CRAWLER_BLOCK_MEDIA="true"

# Crawl pacing (recommended)
CRAWLER_REQUEST_DELAY_MIN="2000"
CRAWLER_REQUEST_DELAY_MAX="6000"
CRAWLER_MAX_CONCURRENT_PAGES="2"
CRAWLER_MAX_PAGES_PER_KEYWORD="2"
