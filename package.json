{
  "name": "tkanmarket",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3006 --webpack",
    "dev:turbo": "next dev -p 3006 --turbo",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start -p 3006",
    "lint": "eslint .",
    "typecheck": "rm -rf .next/types .next/dev/types || true; rm -f tsconfig.tsbuildinfo; tsc --noEmit",
    "typecheck:workers": "tsc -p tsconfig.workers.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:workers",
    "db:generate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "npm run build:workers && node --env-file=.env dist-workers/src/db/seed.js",
    "build:workers": "rm -rf dist-workers || true; tsc -p tsconfig.workers.json && tsc-alias -p tsconfig.workers.json",
    "worker:ai": "node --env-file=.env dist-workers/src/workers/ai.worker.js",
    "worker:image": "node --env-file=.env dist-workers/src/workers/image.worker.js",
    "worker:social": "node --env-file=.env dist-workers/src/workers/social.worker.js",
    "worker:crawler": "node --env-file=.env dist-workers/src/workers/crawler.worker.js",
    "worker:all": "node --env-file=.env dist-workers/src/workers/index.js",
    "playwright:install": "playwright install chromium",
    "feature:list": "node scripts/feature-cli.mjs list",
    "feature:enable": "node scripts/feature-cli.mjs enable",
    "feature:disable": "node scripts/feature-cli.mjs disable",
    "feature:purge": "node scripts/feature-cli.mjs purge"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.14.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-table": "^8.0.0",
    "bullmq": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.2",
    "next-auth": "5.0.0-beta.30",
    "playwright": "^1.59.1",
    "postgres": "^3.4.5",
    "psycopg2-binary": "^0.0.1",
    "react": "^19.0.0",
    "react-day-picker": "^9.4.4",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.72.0",
    "recharts": "^2.12.7",
    "sonner": "^1.5.0",
    "sqlalchemy": "^10.1.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/xlsx": "^0.0.35",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "latest",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.2",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.5.4"
  }
}
