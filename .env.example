## Database (required)
# PostgreSQL connection string used by Drizzle (postgres-js driver).
# Example local:
# DATABASE_URL="postgres://postgres:postgres@localhost:5432/tkanmarket"
DATABASE_URL=""

# Optional: cap postgres-js pool size (default 10). Lower if you hit "too many clients already".
# DATABASE_POOL_MAX="5"

## Redis (required for BullMQ)
# Example local:
# REDIS_URL="redis://localhost:6379"
REDIS_URL=""

## Google Gemini API (required for all AI features)
# Get a free API key at https://aistudio.google.com/apikey
# One key works for text (gemini-3.6-flash), image (Nano Banana 2),
# and video (Gemini Omni Flash) — no Vertex AI project needed.
GOOGLE_API_KEY=""

## Auth (required)
# Required: use `openssl rand -base64 32` (or any strong random string). Empty values cause MissingSecret at runtime.
# `AUTH_SECRET` is also accepted (see `src/lib/auth/config.ts`).
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Production behind nginx (VPS): set to public origin, e.g. https://yourdomain.com
# Optional override for Auth.js v5: AUTH_URL (same value as NEXTAUTH_URL).
# Force trust Host header: AUTH_TRUST_HOST=true (usually not needed if NEXTAUTH_URL is set; see src/lib/auth/config.ts).

## Site URL (recommended, used by sitemap/robots/SEO canonical URLs)
# If empty, the app falls back to NEXTAUTH_URL or VERCEL_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

## Public documentation URL (optional)
# Admin login footer "Documentation" opens this in a new tab when set; otherwise it links to the localized Contact page.
NEXT_PUBLIC_DOCS_URL=""

## Logging (optional)
# LOG_LEVEL="debug" enables debug logs; default is info/warn/error.
LOG_LEVEL=""

## Bundle analyzer (optional)
# Set to "true" to enable Next.js bundle analyzer (requires @next/bundle-analyzer installed).
ANALYZE="false"

## Admin bootstrap (required for Credentials auth)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

## Cloudflare R2 (optional, for media storage)
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_R2_PUBLIC_BASE_URL=""

## Social integrations — OAuth credentials
# If *_REDIRECT_URI is empty, the route defaults to:
#   ${NEXTAUTH_URL}/api/v1/admin/social/integrations/<platform>/callback
# Register the same URL in each platform's developer console.

INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_REDIRECT_URI=""
# Token used by Instagram to verify webhook subscription (arbitrary random string)
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI=""
FACEBOOK_WEBHOOK_VERIFY_TOKEN=""

TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI=""

PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
PINTEREST_REDIRECT_URI=""

YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI=""

## Social token encryption (REQUIRED if any social integration is used)
# Key used by src/lib/crypto/token-crypto.ts to AES-256-GCM-encrypt OAuth tokens at rest.
# Preferred: 32 raw bytes in hex or base64. Generate with either:
#   openssl rand -hex 32
#   openssl rand -base64 32
# Any other string is SHA-256-derived to 32 bytes (still safe, but hex is cleaner).
# Rotate by re-authenticating each platform after rollout.
SOCIAL_TOKEN_ENCRYPTION_KEY=""

## Per-platform image variants (optional)
# When set, platform-specific image variants are composed as:
#   <CDN_IMAGE_RESIZER_BASE>/cdn-cgi/image/width=W,height=H,fit=.../<original-url>
# Matches Cloudflare Image Resizing. Leave empty to fall back to ?w=&h=&q= query params.
CDN_IMAGE_RESIZER_BASE=""

## Public links (optional, used in Footer)
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_PINTEREST_URL=""
NEXT_PUBLIC_TELEGRAM_URL=""
NEXT_PUBLIC_WHATSAPP_URL=""

## Crawler (optional, for `crawler.worker.ts`)
# Use ONE of: CRAWLER_PROXY_URL, CRAWLER_PROXY_HOSTPORT, or CRAWLER_PROXY_URLS (comma list).
# Prefer setting secrets only in deployment env — never commit real credentials.
#
# Standard URL (Playwright-compatible; special chars in password should be percent-encoded):
# CRAWLER_PROXY_URL="http://user:pass@geo.iproyal.com:12321"
#
# Provider "formatted list" line (host:port:user:pass) — avoids URL-encoding issues:
# CRAWLER_PROXY_HOSTPORT="geo.iproyal.com:12321:your_user:your_pass"
# Optional protocol for HOSTPORT lines only — http (default) or socks5
CRAWLER_PROXY_PROTOCOL="http"
#
# Optional: append to proxy username for sticky sessions (e.g. IPRoyal `_session-abc123` suffix).
# Leave empty for per-connection rotation (typical with rotating residential pools).
CRAWLER_PROXY_USERNAME_SUFFIX=""
#
CRAWLER_PROXY_URL=""
# Comma-separated extra URLs for round-robin (combined with CRAWLER_PROXY_URL if set)
CRAWLER_PROXY_URLS=""
CRAWLER_PROXY_HOSTPORT=""

# Optional: site cookies (helps with 1688/Alibaba login/captcha).
# Format: JSON array (Cookie-Editor export is supported). Keep it single-line or properly escaped.
# Example (truncated):
# CRAWLER_SITE_COOKIES='[{"name":"foo","value":"bar","domain":".1688.com","path":"/","secure":true}]'
CRAWLER_SITE_COOKIES=""

# Bandwidth saver (recommended for proxy cost reduction)
# Blocks heavy resources while scraping. Defaults are enabled if variables are unset.
CRAWLER_REQUEST_BLOCKING_ENABLED="true"
CRAWLER_BLOCK_IMAGES="true"
CRAWLER_BLOCK_FONTS="true"
CRAWLER_BLOCK_MEDIA="true"

# Currency conversion (1688 prices are often CNY)
CRAWLER_CNY_TO_USD_RATE="0.14"
# Randomized delay between requests
CRAWLER_REQUEST_DELAY_MIN="1500"
CRAWLER_REQUEST_DELAY_MAX="4000"
# Per keyword search depth
CRAWLER_MAX_PAGES_PER_KEYWORD="3"
# Max concurrent pages per worker process (browser manager semaphore)
CRAWLER_MAX_CONCURRENT_PAGES="3"
# Dedupe cache TTL (seconds)
CRAWLER_DEDUPE_TTL_SECONDS="604800"
# Per-page navigation timeout in milliseconds
CRAWLER_PAGE_TIMEOUT="30000"

